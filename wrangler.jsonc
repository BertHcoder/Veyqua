{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veyqua",
  "compatibility_date": "2026-09-12",
  // Static assets only (no Worker script): requests are served free and unlimited.
  // All user data lives in the visitor's browser; there is no backend.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Cloudflare creates the DNS record and certificate for this hostname.
  "routes": [{ "pattern": "veyqua.itaanhuys.com", "custom_domain": true }],
}
